# ── Supabase (required) ──────────────────────────────────────────────
# Dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed for scripts/admin tasks that must bypass Row Level Security
# (e.g. a future backfill script). The app itself never needs this at
# runtime. NEVER prefix this with NEXT_PUBLIC_ and never commit a real
# value — it grants full access to your database.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (optional — narrative report/strategy/action plan + the
# "Ask AeroMind" feature show a "coming soon" state until this is set) ──
AI_PROVIDER_API_KEY=

# ── Payment links (optional — pricing buttons show "Coming soon" until
# these are set). Paste the checkout URL from your payment provider
# (Stripe Payment Links, Lemon Squeezy, Paddle, etc.) for each paid plan.
# Starter is free and Enterprise is "talk to us", so neither needs a link. ─
GROWTH_PAYMENT_LINK=
SCALE_PAYMENT_LINK=
