# ── Supabase (required) ──────────────────────────────────────────────
# Dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by the Selar/Zapier billing webhook and the credit-reset cron route
# ONLY (src/lib/supabase/service.ts) — these are the two places that must
# run without a signed-in user, so they bypass Row Level Security entirely.
# Every other part of the app goes through RLS. NEVER prefix this with
# NEXT_PUBLIC_ and never commit a real value — it grants full access to your
# database.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (required for the Sales Briefing, Next Best Actions and
# Ask AeroMind features — they show a "coming soon" state until this is set) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Billing webhook (required for automatic plan/credit updates when
# someone pays via Selar). Set this same value as a custom header
# (x-aeromind-webhook-secret) on the "Webhooks by Zapier" action in your
# Selar → Zapier Zap. ──
SELAR_WEBHOOK_SECRET=

# ── Cron (required for the monthly credit reset to run automatically via
# Vercel Cron — see vercel.json). Vercel sends this as a Bearer token
# automatically once the env var is set. ──
CRON_SECRET=

# ── Payment links (optional — pricing buttons show "Coming soon" until
# these are set). Paste the checkout URL from Selar for each paid plan.
# Free needs no link. If you previously set GROWTH_PAYMENT_LINK /
# SCALE_PAYMENT_LINK (from the old plan names), those still work as a
# fallback — no need to duplicate them, though renaming is cleaner. ─
PROFESSIONAL_PAYMENT_LINK=
BUSINESS_PAYMENT_LINK=
